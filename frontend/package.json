{
"pnpm": {
  "overrides": {
    "js-beautify@2.0.3>glob": "14.0.2",
    "editorconfig@3.0.2>minimatch": "11.0.1",
    "@vscode/markdown-it-katex@1.1.2>katex": "0.19.1"
  }
},
  "name": "frontend",
  "version": "2.7.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node generate-sitemap.js && node generate-llms-txt.js && vite build && node generate-og-metadata.js && node generate-llms-txt.js",
    "llms": "node generate-llms-txt.js",
    "og:generate": "node generate-og-metadata.js",
    "preview": "vite preview",
    "lint": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:e2e:headed": "playwright test --headed",
    "sitemap": "node generate-sitemap.js"
  },
  "dependencies": {
    "@shikijs/transformers": "^3.23.0",
    "@vscode/markdown-it-katex": "^1.1.2",
    "@vueuse/core": "^14.4.0",
    "axios": "^1.21.1",
    "katex": "^0.19.1",
    "shiki": "^4.6.0",
    "vue": "^3.5.45",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.65.0",
    "@prettier/plugin-xml": "^3.4.2",
    "@resvg/resvg-js": "^2.6.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^4.1.12",
    "@vitest/ui": "^4.1.12",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^16.5.0",
    "gray-matter": "^4.0.3",
    "jsdom": "^27.4.0",
    "markdown-it-container": "^4.0.0",
    "prettier": "^3.9.10",
    "rollup-plugin-visualizer": "^7.1.3",
    "sitemap": "^9.0.1",
    "unplugin-vue-components": "^31.1.0",
    "unplugin-vue-markdown": "^32.1.1",
    "vite": "^7.3.8",
    "vitest": "^4.1.12",
    "vue-eslint-parser": "^10.4.2"
  }
}
